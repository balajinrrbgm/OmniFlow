# OmniFlow Environment Variables
# Get your API key from Aurora Intents Widget Studio
NEXT_PUBLIC_AURORA_API_KEY=your_aurora_widget_studio_api_key
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta

# 1Click Swap API
NEXT_PUBLIC_ONECLICK_API_BASE=https://1click.chaindefuser.com
NEXT_PUBLIC_ONECLICK_JWT_TOKEN=your_jwt_token

# App Configuration
NEXT_PUBLIC_APP_NAME=OmniFlow
NEXT_PUBLIC_FEE_BPS=50

